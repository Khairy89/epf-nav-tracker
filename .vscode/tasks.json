{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe -m pip install -r requirements.txt",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run NAV Scheduler",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe ${workspaceFolder}/nav_scheduler.py",
      "group": "none",
      "problemMatcher": []
    }
  ]
}
